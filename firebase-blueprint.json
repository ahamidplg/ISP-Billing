{
  "entities": {
    "Tenant": {
      "title": "Tenant",
      "description": "Information about the ISP organization using the platform.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "slug"]
    },
    "Router": {
      "title": "Router",
      "description": "Mikrotik or Edge router configuration.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "name": { "type": "string" },
        "ip": { "type": "string" },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "status": { "type": "string", "enum": ["online", "offline", "warning"] },
        "lastSeen": { "type": "string", "format": "date-time" }
      },
      "required": ["tenantId", "name", "ip"]
    },
    "Plan": {
      "title": "Plan",
      "description": "Service tier (e.g., 50Mbps Fiber).",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "name": { "type": "string" },
        "limit": { "type": "string", "description": "e.g., 50M/10M" },
        "price": { "type": "number" },
        "currency": { "type": "string" }
      },
      "required": ["tenantId", "name", "limit", "price"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Subscriber information.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "name": { "type": "string" },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "address": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "planId": { "type": "string" },
        "routerId": { "type": "string" },
        "macAddress": { "type": "string", "description": "MAC address of the customer ONT/Router." },
        "status": { "type": "string", "enum": ["active", "suspended", "expired"] },
        "balance": { "type": "number" }
      },
      "required": ["tenantId", "name", "username", "planId"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Billing record for a customer.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "customerId": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["paid", "unpaid", "overdue"] },
        "dueDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tenantId", "customerId", "amount", "status", "dueDate"]
    },
    "OltNode": {
      "title": "OLT Node",
      "description": "Optical Line Terminal hardware (Huawei, ZTE, BDCOM).",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "name": { "type": "string" },
        "ip": { "type": "string" },
        "sn": { "type": "string" },
        "brand": { "type": "string", "enum": ["huawei", "zte", "bdcom", "generic"] },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "protocol": { "type": "string", "enum": ["ssh", "telnet"] },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["tenantId", "name", "brand", "ip"]
    },
    "Onu": {
      "title": "ONU",
      "description": "Details of an ONT/ONU connected to OLT",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "sn": { "type": "string" },
        "oltId": { "type": "string" },
        "ponPort": { "type": "string" },
        "onuIndex": { "type": "string" },
        "signal": { "type": "number" },
        "status": { "type": "string" },
        "customerId": { "type": "string" }
      },
      "required": ["tenantId", "sn", "oltId"]
    },
    "OdpNode": {
      "title": "ODP Node",
      "description": "Optical Distribution Point (splitter).",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "oltId": { "type": "string" },
        "name": { "type": "string" },
        "ports": { "type": "number" },
        "lat": { "type": "number" },
        "lng": { "type": "number" }
      },
      "required": ["tenantId", "oltId", "name"]
    },
    "Member": {
      "title": "Member",
      "description": "A user assigned to a tenant with a specific role.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "userId": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "staff"] }
      },
      "required": ["tenantId", "userId", "role"]
    },
    "PppoeProfile": {
      "title": "PPPoE Profile",
      "description": "Mikrotik PPPoE profile configuration.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "remoteAddress": { "type": "string" },
        "rateLimit": { "type": "string" }
      },
      "required": ["tenantId", "name"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial ledger record (income or expense).",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "description": { "type": "string" },
        "referenceNo": { "type": "string" },
        "recordedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tenantId", "type", "category", "amount", "date"]
    },
    "Asset": {
      "title": "Asset",
      "description": "Equipment, network infrastructure, tools, and company assets.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "assetCode": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "brandModel": { "type": "string" },
        "serialNumber": { "type": "string" },
        "purchaseDate": { "type": "string" },
        "purchasePrice": { "type": "number" },
        "currentValue": { "type": "number" },
        "status": { "type": "string" },
        "location": { "type": "string" },
        "assignedTo": { "type": "string" }
      },
      "required": ["tenantId", "assetCode", "name", "category", "purchasePrice", "status"]
    },
    "AssetLoan": {
      "title": "Asset Loan Log",
      "description": "Log of technician borrowing and returning equipment/tools.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "assetId": { "type": "string" },
        "assetCode": { "type": "string" },
        "assetName": { "type": "string" },
        "employeeId": { "type": "string" },
        "employeeName": { "type": "string" },
        "borrowDate": { "type": "string" },
        "expectedReturnDate": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["tenantId", "assetId", "employeeId", "borrowDate", "status"]
    },
    "Employee": {
      "title": "Employee",
      "description": "ISP staff, technicians, NOC, and administration personnel.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "employeeCode": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string" },
        "department": { "type": "string" },
        "employmentType": { "type": "string" },
        "joinDate": { "type": "string" },
        "status": { "type": "string" },
        "basicSalary": { "type": "number" },
        "allowance": { "type": "number" },
        "psbIncentivePerTask": { "type": "number" }
      },
      "required": ["tenantId", "employeeCode", "name", "role", "department", "status"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Daily employee attendance and shift logs.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "employeeId": { "type": "string" },
        "employeeName": { "type": "string" },
        "date": { "type": "string" },
        "checkIn": { "type": "string" },
        "status": { "type": "string" },
        "shift": { "type": "string" }
      },
      "required": ["tenantId", "employeeId", "date", "status"]
    },
    "WorkOrder": {
      "title": "Work Order",
      "description": "Technician task orders (PSB, repair, maintenance).",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "orderNumber": { "type": "string" },
        "type": { "type": "string" },
        "customerName": { "type": "string" },
        "address": { "type": "string" },
        "assignedTechnicianId": { "type": "string" },
        "priority": { "type": "string" },
        "status": { "type": "string" },
        "scheduledDate": { "type": "string" }
      },
      "required": ["tenantId", "orderNumber", "type", "customerName", "status", "scheduledDate"]
    },
    "PayrollSlip": {
      "title": "Payroll Slip",
      "description": "Monthly salary slip for employees.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "slipNumber": { "type": "string" },
        "employeeId": { "type": "string" },
        "employeeName": { "type": "string" },
        "period": { "type": "string" },
        "basicSalary": { "type": "number" },
        "totalTakeHomePay": { "type": "number" },
        "paymentStatus": { "type": "string" }
      },
      "required": ["tenantId", "slipNumber", "employeeId", "period", "totalTakeHomePay", "paymentStatus"]
    },
    "BhpTaxReport": {
      "title": "BHP & Tax Report",
      "description": "Indonesian telecom BHP Tel 0.5%, BHP USO 1.25%, PPN and income tax reporting.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "reportNumber": { "type": "string" },
        "periodLabel": { "type": "string" },
        "totalGrossRevenue": { "type": "number" },
        "totalDeductible": { "type": "number" },
        "netRevenueBase": { "type": "number" },
        "bhpTelAmount": { "type": "number" },
        "bhpUsoAmount": { "type": "number" },
        "totalBhpPnbp": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["tenantId", "reportNumber", "periodLabel", "totalGrossRevenue", "totalBhpPnbp", "status"]
    },
    "Pph23Record": {
      "title": "PPh 23 Record",
      "description": "Tax withholding on ISP pole rentals and contractor engineering services.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "vendorName": { "type": "string" },
        "grossAmount": { "type": "number" },
        "taxAmount": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["tenantId", "vendorName", "grossAmount", "taxAmount", "status"]
    }
  },
  "firestore": {
    "tenants": {
      "schema": "Tenant",
      "description": "Platform tenants."
    },
    "members": {
      "schema": "Member",
      "description": "Membership in tenants."
    },
    "routers": {
      "schema": "Router",
      "description": "Network hardware."
    },
    "plans": {
      "schema": "Plan",
      "description": "Internet service plans."
    },
    "customers": {
      "schema": "Customer",
      "description": "Subscribers."
    },
    "invoices": {
      "schema": "Invoice",
      "description": "Billing history."
    },
    "transactions": {
      "schema": "Transaction",
      "description": "Financial ledger transactions (income/expense)."
    },
    "assets": {
      "schema": "Asset",
      "description": "Infrastructure, equipment, tool inventory."
    },
    "asset_loans": {
      "schema": "AssetLoan",
      "description": "Technician equipment loan log."
    },
    "employees": {
      "schema": "Employee",
      "description": "Employees, technicians, NOC, and staff directory."
    },
    "attendances": {
      "schema": "Attendance",
      "description": "Daily employee attendance records."
    },
    "work_orders": {
      "schema": "WorkOrder",
      "description": "Technician job orders, PSB and repairs."
    },
    "payroll_slips": {
      "schema": "PayrollSlip",
      "description": "Generated payroll and salary slips."
    },
    "bhp_tax_reports": {
      "schema": "BhpTaxReport",
      "description": "BHP Telekomunikasi, BHP USO and tax calculations for Ditjen PPI Kominfo & DJP."
    },
    "pph23_records": {
      "schema": "Pph23Record",
      "description": "PPh 23 tax withholding records for pole rental and vendor services."
    },
    "olt_nodes": {
      "schema": "OltNode",
      "description": "FTTH OLT infrastructure."
    },
    "onus": {
      "schema": "Onu",
      "description": "Individual Optical Network Units (ONTs)."
    },
    "odp_nodes": {
      "schema": "OdpNode",
      "description": "FTTH ODP splitters."
    },
    "pppoe_profiles": {
      "schema": "PppoeProfile",
      "description": "PPPoE profile configurations for routers."
    }
  }
}
